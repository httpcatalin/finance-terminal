# ============================================================================
# Financial Terminal DSL Grammar (BNF) - Version 2.0
# ============================================================================
# 
# This grammar defines the complete syntax for the Financial Terminal Domain-
# Specific Language (DSL). It is designed for financial analysis scripts that
# support stock, option, futures, and bond analysis with embedded calculations.
#
# Complexity: Advanced (50+ production rules, 10-level expression precedence)
# Status: Week 6 Validated (Mentor Reviewed & Test-Verified)
# Target Implementation: ANTLR v4.13+
#
# Key Features:
#  - Unambiguous operator precedence via expression hierarchy
#  - Support for nested data structures (arrays, dictionaries, blocks)
#  - Domain-specific keywords for financial analysis
#  - Flexible optional components for both minimal and rich programs
#  - Proper handling of control flow (if/else, while, for) with left-recursion
#
# ============================================================================

# ============================================================================
# PROGRAM STRUCTURE
# ============================================================================

<program> ::= <statement_list>

<statement_list> ::= <statement> | <statement> <statement_list>

# ============================================================================
# STATEMENT TYPES
# ============================================================================

<statement> ::= <declaration_stmt> | <assignment_stmt> | <analyze_stmt> | <calculate_stmt> | <show_stmt> | <if_stmt> | <while_stmt> | <for_stmt> | <function_def> | <return_stmt> | <expression_stmt> | <block_stmt>

# Block statement for grouping multiple statements
<block_stmt> ::= "{" <statement_list> "}"

# Variable and constant declaration
<declaration_stmt> ::= <type> <identifier> | <type> <identifier> "=" <expression>

# Variable/array/struct assignment
<assignment_stmt> ::= <identifier> "=" <expression> | <identifier> "[" <expression> "]" "=" <expression> | <identifier> "." <identifier> "=" <expression>

# ============================================================================
# DOMAIN-SPECIFIC STATEMENTS (Financial Analysis)
# ============================================================================

<analyze_stmt> ::= "analyze" <asset_type> <ticker> "for" <period> <analyze_options>

<analyze_options> ::= <analyze_option> | <analyze_option> <analyze_options> | ε

<analyze_option> ::= "with" <identifier> | "filter" <expression> | "group" "by" <identifier>

<key> ::= "growth" | "discount" | "beta" | "years" | "terminal_growth" | "strike" | "volatility" | "maturity" | "underlying" | "cost_of_carry" | "expiry" | "face_value" | "coupon" | "ytm"

<calculate_stmt> ::= "calculate" <calc_type> "for" <ticker> <params> <calc_options>

<calc_options> ::= <calc_option> | <calc_option> <calc_options> | ε

<calc_option> ::= "using" <identifier> | "method" <string> | "iterations" <number>

<show_stmt> ::= "show" <show_type> "for" <ticker> <show_filters> <show_format>

<show_filters> ::= "where" <expression> | ε

<show_format> ::= "as" <format_type> | ε

<format_type> ::= "table" | "chart" | "json" | "csv"

# ============================================================================
# CONTROL FLOW STATEMENTS
# ============================================================================

# If-else statement with optional else clause
<if_stmt> ::= "if" "(" <expression> ")" <statement> | "if" "(" <expression> ")" <statement> "else" <statement>

# While loop (condition checked before each iteration)
<while_stmt> ::= "while" "(" <expression> ")" <statement>

# For loop (iterator pattern over collections)
<for_stmt> ::= "for" "(" <identifier> "in" <expression> ")" <statement>

# ============================================================================
# FUNCTION DEFINITIONS & RETURNS
# ============================================================================

<function_def> ::= "def" <identifier> "(" <param_list> ")" <statement>

<param_list> ::= <param> | <param> "," <param_list> | ε

<param> ::= <type> <identifier>

<return_stmt> ::= "return" <expression> | "return"

<expression_stmt> ::= <expression> ";"

# ============================================================================
# TYPE SYSTEM
# ============================================================================

# Primitive and composite types
<type> ::= "int" | "float" | "string" | "bool" | "date" | "currency" | "stock" | "option" | "future" | "bond" | "array" "[" <type> "]" | "dict" "[" <type> "," <type> "]"

# ============================================================================
# EXPRESSION HIERARCHY (Operator Precedence - Lowest to Highest)
# ============================================================================

<expression> ::= <logical_or_expr>

<logical_or_expr> ::= <logical_and_expr> | <logical_or_expr> "||" <logical_and_expr>

<logical_and_expr> ::= <equality_expr> | <logical_and_expr> "&&" <equality_expr>

<equality_expr> ::= <comparison_expr> | <equality_expr> "==" <comparison_expr> | <equality_expr> "!=" <comparison_expr>

<comparison_expr> ::= <additive_expr> | <comparison_expr> "<" <additive_expr> | <comparison_expr> ">" <additive_expr> | <comparison_expr> "<=" <additive_expr> | <comparison_expr> ">=" <additive_expr>

<additive_expr> ::= <multiplicative_expr> | <additive_expr> "+" <multiplicative_expr> | <additive_expr> "-" <multiplicative_expr>

<multiplicative_expr> ::= <unary_expr> | <multiplicative_expr> "*" <unary_expr> | <multiplicative_expr> "/" <unary_expr> | <multiplicative_expr> "%" <unary_expr>

<unary_expr> ::= <power_expr> | "!" <unary_expr> | "-" <unary_expr> | "+" <unary_expr>

<power_expr> ::= <primary_expr> | <power_expr> "^" <unary_expr>

# ============================================================================
# PRIMARY EXPRESSIONS & LITERALS
# ============================================================================

<primary_expr> ::= <literal> | <identifier> | "(" <expression> ")" | <function_call> | <array_literal> | <dict_literal> | <member_access> | <array_access>

<function_call> ::= <identifier> "(" <arg_list> ")"

<arg_list> ::= <expression> | <expression> "," <arg_list> | ε

<array_literal> ::= "[" <arg_list> "]"

<dict_literal> ::= "{" <key_value_list> "}"

<key_value_list> ::= <expression> ":" <expression> | <expression> ":" <expression> "," <key_value_list> | ε

<member_access> ::= <primary_expr> "." <identifier>

<array_access> ::= <primary_expr> "[" <expression> "]"

<literal> ::= <number> | <string> | <bool_literal> | <date_literal> | <currency_literal>

<bool_literal> ::= "true" | "false"

<date_literal> ::= "date" "(" <string> ")"

<currency_literal> ::= "currency" "(" <number> "," <string> ")"

# ============================================================================
# DOMAIN-SPECIFIC ELEMENTS
# ============================================================================

<asset_type> ::= "stock" | "option" | "future" | "bond" | "portfolio"

<ticker> ::= <identifier>

<period> ::= <string> | <number> <time_unit>

<time_unit> ::= "days" | "weeks" | "months" | "years"

<calc_type> ::= "dcf" | "black_scholes" | "futures_price" | "bond_price" | "volatility" | "sharpe_ratio" | "var" | "correlation" | "beta" | "monte_carlo"

<params> ::= <param> | <param> <params> | ε

# Parameter binding in calculate statements: "param_name value"
<param> ::= <identifier> <expression>

<show_type> ::= "income_statement" | "balance_sheet" | "cash_flow" | "prices" | "volatility" | "ratios" | "chart" | "statistics" | "correlation_matrix" | "portfolio_performance" | "moat"

# ============================================================================
# LEXICAL ELEMENTS (Terminals)
# ============================================================================

<identifier> ::= [a-zA-Z_][a-zA-Z0-9_]*

<number> ::= [0-9]+ ("." [0-9]+)? (("e"|"E") ("+"|"-")? [0-9]+)?

<string> ::= "\"" ([^"\\] | "\\" .)* "\"" | "'" ([^'\\] | "\\" .)* "'"

# ============================================================================
# END OF GRAMMAR - Version 2.0 (Week 6 Validated & Mentor Approved)
# ============================================================================

# =========================================================================
# News & Sentiment Commands
# =========================================================================

<news_stmt>  ::= "news" <ticker> [ <date_range> ] [ "limit" <integer> ]

<date_range> ::= "today"
               | "yesterday"
               | "last_week"
               | "last_month"
               | <YYYY-MM-DD>

<YYYY-MM-DD> ::= [0-9]{4} "-" [0-9]{2} "-" [0-9]{2}

Examples:
	news GOOGL
	news GOOGL today
	news AAPL 2025-03-19
	news META last_week
	news TSLA today limit 20

Examples:
	calculate dcf for AAPL growth 0.15 years 10
	calculate dcf for GOOGL growth 0.10 beta 1.00 years 10
	calculate dcf for GOOGL growth 0.10 discount 0.09 years 10
	calculate dcf for META growth 0.12 years 10 terminal_growth 0.025
	calculate dcf for MSFT growth 0.08 discount auto years 10 terminal_growth 0.03
	show moat for GOOGL

# =========================================================================
# Option Pricing Commands (POSIX-style)
# =========================================================================
#
# Syntax:  COMMAND TICKER [KEY=VALUE ...] [--flag ...]
#
# Session: use SET TICKER to avoid repeating the ticker on every command.
#
# <option_command> ::= <cmd> <ticker>? <kwargs>* <flags>*
# <cmd>     ::= "BSM" | "BIN" | "MC" | "GARCH" | "VOL" | "IV"
#             | "STRAT" | "COMPARE" | "VAR" | "CHAIN" | "SET" | "HELP"
# <ticker>  ::= [A-Z]{1,5}
# <kwargs>  ::= <key> "=" <value>
# <flags>   ::= "--" <word>
# <key>     ::= "K" | "T" | "sigma" | "r" | "q" | "N" | "B" | "steps"
#             | "K1" | "K2" | "K3" | "PRICE" | "conf" | "horizon"
#             | "expiry" | "option_type" | "vs"
# <value>   ::= <number> | <percent> | <string>
# <percent> ::= <number> "%"
#
# Option Pricing Examples:
#   SET GOOG
#   BSM GOOG K=150 T=0.25 --graph
#   BSM GOOG K=150 T=0.25 --graph --delta
#   BIN GOOG K=150 T=0.25 --american
#   BIN GOOG K=150 T=0.25 steps=500 --graph
#   MC GOOG K=150 T=0.25 N=100000
#   MC GOOG K=150 --asian
#   MC GOOG K=150 --barrier B=130 --up-and-out
#   MC GOOG --lookback
#   GARCH GOOG --forecast --graph
#   VOL GOOG --smile
#   VOL GOOG --surface
#   IV GOOG K=150 T=0.25 PRICE=8.50
#   STRAT GOOG straddle K=150 --graph
#   STRAT GOOG bull-spread K1=140 K2=160 --graph
#   STRAT GOOG butterfly K1=140 K2=150 K3=160 --graph
#   COMPARE GOOG K=150 T=0.25 --graph
#   VAR GOOG --hist --graph
#   VAR GOOG --mc conf=0.99 horizon=10
#   CHAIN GOOG
#   CHAIN GOOG expiry=2026-06-19
#   HELP
